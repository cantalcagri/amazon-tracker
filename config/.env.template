# Amazon Seller Tracker — Environment Config
# Copy this to: amazon-tracker/pipeline/.env

# ── Required ────────────────────────────────────────────────────
# Keepa HTTP API key (Path B — per-seller collector). Get it at
# https://keepa.com/#!api . Rotate if it has ever been pasted in chat/logs.
KEEPA_API_KEY=

# ── Optional ────────────────────────────────────────────────────
# Path to the SQLite database. MUST be a local APFS path — never iCloud /
# Dropbox / a network mount (that triggers SQLite "disk I/O error").
# Defaults to pipeline/amazon_tracker.db when unset.
DB_PATH=amazon_tracker.db
