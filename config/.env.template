# Amazon Seller Tracker — Environment Config
# Copy this to: amazon-tracker/pipeline/.env

# ── Required ───────────────────────────────────────────────────
# Your Chrome user data directory (where Keepa extension is installed).
# Script auto-detects this on most systems, but set it if it fails.
#
# macOS:   /Users/YOUR_NAME/Library/Application Support/Google/Chrome
# Windows: C:\Users\YOUR_NAME\AppData\Local\Google\Chrome\User Data
# Linux:   /home/YOUR_NAME/.config/google-chrome
#
CHROME_PROFILE_PATH=

# ── Optional ────────────────────────────────────────────────────
# Path to SQLite database (created automatically on first run)
DB_PATH=amazon_tracker.db

# Keepa API key — only needed if you switch to API mode later
# KEEPA_API_KEY=

# Keepa login credentials — used to auto-login on first run so stock data is visible
# KEEPA_USERNAME=your_keepa_username
# KEEPA_PASSWORD=your_keepa_password
